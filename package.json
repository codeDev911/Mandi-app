{
  "name": "Mandi App",
  "private": true,
  "version": "1.0.0",
  "description": "Mandi Bolli Commission Billing and Khata App",
  "author": " Afnan Ahad",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "cap:sync": "cap sync android",
    "cap:build": "vite build && cap sync android",
    "cap:open": "cap open android",
    "neu:update": "neu update",
    "neu:build": "vite build && neu build --release",
    "neu:run": "neu run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1144.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/status-bar": "^8.0.3",
    "@google/genai": "^2.4.0",
    "@neondatabase/serverless": "^1.1.0",
    "@neutralinojs/lib": "^6.9.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@neutralinojs/neu": "^11.7.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.34.8",
    "@rollup/rollup-linux-x64-gnu": "^4.34.8",
    "lightningcss-win32-x64-msvc": "^1.29.1",
    "lightningcss-linux-x64-gnu": "^1.29.1",
    "@tailwindcss/oxide-win32-x64-msvc": "^4.1.14"
  }
}
